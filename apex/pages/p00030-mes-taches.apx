page 30 (
    name: Mes taches
    alias: MES-TACHES
    title: Mes taches - Service Desk Lite
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
        warnOnUnsavedChanges: false
    }
    css {
        fileUrls: #APP_FILES#app.css
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region my-tasks-breadcrumb (
        name: Mes taches
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useRegionTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region my-tasks-report (
        name: Taches qui demandent mon attention
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select task_id,
                       task_type,
                       task_def_name,
                       subject,
                       actual_owner,
                       priority,
                       due_on,
                       state_code,
                       outcome,
                       created_on,
                       details_link_target
                  from table(apex_human_task.get_tasks(
                         p_context        => 'MY_TASKS',
                         p_application_id => :APP_ID
                       ))
                 order by created_on desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
            cssClasses: sd-report-region
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        performance {
            maxRowsToProcess: 1000000
        }
        messages {
            whenNoDataFound: Aucune tache ne demande votre attention.
        }
        download {
            formats: [
                csv
                excel
                pdf
            ]
            sendAsEmail: false
        }
        advanced {
            savedReportMappingIdentifier: 102030000000011
        }

        column ACTUAL_OWNER (
            type: plainText
            heading {
                heading: Proprietaire
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: E
            }
        )

        column CREATED_ON (
            type: plainText
            heading {
                heading: Creee le
            }
            layout {
                sequence: 100
            }
            appearance {
                formatMask: DD/MM/YYYY HH24:MI
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: J
            }
        )

        column DETAILS_LINK_TARGET (
            type: hidden
            heading {
                heading: Lien
            }
            layout {
                sequence: 110
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: K
            }
        )

        column DUE_ON (
            type: plainText
            heading {
                heading: Echeance
            }
            layout {
                sequence: 70
            }
            appearance {
                formatMask: DD/MM/YYYY HH24:MI
            }
            source {
                dataType: DATE
            }
            advanced {
                endUserAlias: G
            }
        )

        column OUTCOME (
            type: plainText
            heading {
                heading: Decision
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: I
            }
        )

        column PRIORITY (
            type: plainText
            heading {
                heading: Priorite
                alignment: end
            }
            layout {
                sequence: 60
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: F
            }
        )

        column STATE_CODE (
            type: plainText
            heading {
                heading: Etat
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: H
            }
        )

        column SUBJECT (
            type: link
            heading {
                heading: Sujet
            }
            layout {
                sequence: 40
            }
            link {
                target: {
                    type: url
                    url: #DETAILS_LINK_TARGET#
                }
                linkText: #SUBJECT#
                linkAttributes: class="sd-ticket-link"
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: D
            }
        )

        column TASK_DEF_NAME (
            type: plainText
            heading {
                heading: Tache
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: C
            }
        )

        column TASK_ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: NUMBER
            }
            advanced {
                endUserAlias: A
            }
        )

        column TASK_TYPE (
            type: plainText
            heading {
                heading: Type
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
            advanced {
                endUserAlias: B
            }
        )

        page {
            borderWidth: 0.5
            borderColor: #666666
        }

        savedReport 102030 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ACTUAL_OWNER (
                sequence: 4
            )

            displayColumn CREATED_ON (
                sequence: 9
            )

            displayColumn DUE_ON (
                sequence: 6
            )

            displayColumn OUTCOME (
                sequence: 8
            )

            displayColumn PRIORITY (
                sequence: 5
            )

            displayColumn STATE_CODE (
                sequence: 7
            )

            displayColumn SUBJECT (
                sequence: 3
            )

            displayColumn TASK_DEF_NAME (
                sequence: 2
            )

            displayColumn TASK_TYPE (
                sequence: 1
            )

        )

    )

    button workflows (
        buttonName: WORKFLOWS
        label: Suivi des workflows
        layout {
            sequence: 10
            region: @my-tasks-breadcrumb
            slot: create
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-workflow
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 32
                clearCache: 32
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

)

