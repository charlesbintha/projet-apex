taskDefinition SD_TICKET_PROCESSING (
    name: Traitement du ticket
    type: action
    task {
        subject: Traiter le ticket &TICKET_NUMBER. - &SUBJECT.
    }
    deadline {
        dueOnType: interval
        interval: P2D
    }
    source {
        type: sqlQuery
        sqlQuery:
            ```sql
            select ticket_number, subject, priority_label, category_name, assigned_agent_name
              from sd_ticket_overview_v
             where ticket_id = :APEX$TASK_PK
            ```
    }
    advanced {
        detailsPage: {
            page: 31
            items: {
                P31_TASK_ID: &TASK_ID.
            }
            clearCache: 31
            action: resetPagination
        }
    }

    parameter P_RESOLUTION_NOTE (
        label: Note de resolution
        validation {
            required: false
        }
        advanced {
            updatable: true
        }
    )

    participant (
        value {
            type: expression
            plsqlExpression: sd_workflow_api.ticket_agent_username(:APEX$TASK_PK)
        }
    )

    participant (
        type: businessAdministrator
        value {
            type: expression
            plsqlExpression: sd_workflow_api.admin_usernames
        }
    )

)

